# autocompact_pct = 85
# disable_traffic = 1
# effort_level    = max

# [profile://kimi-k2.7-code]
# name            = Kimi K2.7 Code
# base_url        = https://api.kimi.com/coding/
# auth_token      = ${ENV:KIMI_API_KEY}
# model           = kimi-k2.7-code
